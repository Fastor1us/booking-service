{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Database": {
    "Users": {
      "DbName": "usersdb",
      "User": "postgres",
      "Password": "postgres"
    },
    "Events": {
      "DbName": "eventsdb",
      "User": "postgres",
      "Password": "postgres"
    },
    "Bookings": {
      "DbName": "bookingsdb",
      "User": "postgres",
      "Password": "postgres"
    }
  },
  "Jwt": {
    "Issuer": "BookingPlatform",
    "Audience": "BookingPlatformClient",
    "SigningKey": "your-secure-signing-key-minimum-32-characters",
    "ExpiresInMinutes": 60
  },
  "EventCacheOptions": {
    "EventTtl": "00:05:00",
    "TopEventsTtl": "00:10:00"
  }
}
