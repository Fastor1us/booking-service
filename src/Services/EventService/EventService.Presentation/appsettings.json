{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EventCacheOptions": {
    "EventTtl": "00:05:00",
    "TopEventsTtl": "00:10:00"
  },
  "Telemetry": {
    "ServiceName": "event-service",
    "ServiceVersion": "1.0.0"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
