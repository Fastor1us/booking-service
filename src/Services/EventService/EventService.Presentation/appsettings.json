{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EventCacheOptions": {
    "EventTtl": "00:05:00",
    "TopEventsTtl": "00:10:00"
  },
  "Telemetry": {
    "ServiceName": "user-service",
    "ServiceVesion": "1.0.0"
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318/v1/traces",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
